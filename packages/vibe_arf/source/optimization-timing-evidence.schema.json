{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIBE Optimization Timing Evidence",
  "type": "object",
  "required": [
    "candidate_sha256", "revision_id", "scenario_id", "runtime_version", "evaluator_version", "simulator_policy_version",
    "wall_time_ms", "compile_ms", "inspect_ms", "runtime_execution_ms", "model_simulation_ms", "artifact_materialization_ms", "evaluation_ms",
    "graph_steps", "model_node_calls", "analyst_interactions", "gap_loop_iterations", "normalize_passes", "contract_audit_passes", "auto_resolve_passes",
    "candidate_compile_count", "runtime_restart_count", "artifact_sha256", "score_regime_id", "valid_evaluation"
  ],
  "properties": {
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "runtime_version": {"type": "string"},
    "evaluator_version": {"type": "string"},
    "simulator_policy_version": {"type": "string"},
    "wall_time_ms": {"type": "number", "minimum": 0},
    "compile_ms": {"type": "number", "minimum": 0},
    "inspect_ms": {"type": "number", "minimum": 0},
    "runtime_execution_ms": {"type": "number", "minimum": 0},
    "model_simulation_ms": {"type": "number", "minimum": 0},
    "artifact_materialization_ms": {"type": "number", "minimum": 0},
    "evaluation_ms": {"type": "number", "minimum": 0},
    "graph_steps": {"type": "integer", "minimum": 0},
    "model_node_calls": {"type": "integer", "minimum": 0},
    "analyst_interactions": {"type": "integer", "minimum": 0},
    "gap_loop_iterations": {"type": "integer", "minimum": 0},
    "normalize_passes": {"type": "integer", "minimum": 0},
    "contract_audit_passes": {"type": "integer", "minimum": 0},
    "auto_resolve_passes": {"type": "integer", "minimum": 0},
    "candidate_compile_count": {"type": "integer", "minimum": 0},
    "runtime_restart_count": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score_regime_id": {"type": "string"},
    "process_score": {"type": ["number", "null"]},
    "result_score": {"type": ["number", "null"]},
    "overall_score": {"type": ["number", "null"]},
    "valid_evaluation": {"type": "boolean"},
    "semantic_complexity_delta": {"type": "number"},
    "recent_valid_wall_times_ms": {"type": "array", "items": {"type": "number", "minimum": 0}}
  },
  "additionalProperties": true
}
