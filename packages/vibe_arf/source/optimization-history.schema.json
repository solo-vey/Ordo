{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe://schemas/optimization-history/v1",
  "title": "Optimization History Entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "problem",
    "baseline_evidence",
    "hypothesis",
    "protected_invariants",
    "regression_asset",
    "change",
    "comparison_evidence",
    "measured_result",
    "limitations",
    "decision"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "baseline_evidence": {},
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "protected_invariants": {
      "type": "array",
      "minItems": 1
    },
    "regression_asset": {
      "type": "string",
      "minLength": 1
    },
    "change": {},
    "comparison_evidence": {},
    "measured_result": {},
    "limitations": {
      "type": "array"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "NO_ACTION",
        "BLOCKED"
      ]
    }
  }
}
