  "architecture_policy_ref": "source/deterministic-first-architecture-policy.json",
  "state_patch_contract_ref": "source/state-patch-v1-contract.json",
  "producer_boundary_validation_required": true,
  "monotonic_lifecycle_guard_required": true,
  "deterministic_recovery_resume_required": true,
  "machine_checkable_completeness_required": true,
  "safe_evidence_hydration_required": true
}
