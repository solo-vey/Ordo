    "dependency_propagation",
    "graph_closure",
    "invalidation",
    "set_difference_preservation",
    "traceability_sync",
    "schema_validation",
    "binding_projection",
    "materialization",
    "scoring",
    "hashing",
    "packaging"
  ],
  "model_allowed_only_for": [
