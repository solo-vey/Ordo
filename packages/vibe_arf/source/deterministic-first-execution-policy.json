{
  "schema_version": "1.0",
  "policy_id": "VIBE_DETERMINISTIC_FIRST_EXECUTION",
  "algorithmic_operation_default": "deterministic",
  "classification_before_node_synthesis": true,
  "model_fallback_requires_explicit_nondeterminism_evidence": true,
  "generated_playbooks_inherit": true,
