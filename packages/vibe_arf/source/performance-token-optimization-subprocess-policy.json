{
  "policy_id": "STANDARD_PERFORMANCE_TOKEN_OPTIMIZATION_SUBPROCESS",
  "version": "1.1",
  "status": "ACTIVE_CANDIDATE_POLICY",
  "purpose": "Reusable performance/token optimization subprocess after a stable quality baseline.",
  "entry_triggers": [
    "explicit_analyst_request",
    "post_quality_hardening",
    "time_or_token_degradation_evidence"
  ],
  "ordered_steps": [
    "capture_quality_and_cost_baseline",
    "gate_quality_stability",
    "audit_context_runtime_efficiency",
    "collect_per_node_telemetry",
    "rank_hotspots",
    "form_one_hypothesis",
    "apply_one_optimization",
    "targeted_comparison",
    "semantic_equivalence_gate",
    "performance_improvement_decision"
  ],
  "metrics": [
    "wall_time",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "node_pass_count",
    "restart_count",
    "compile_count",
    "artifact_quality",
    "startup_loaded_bytes",
    "node_prompt_loaded_bytes",
    "node_knowledge_loaded_bytes",
    "model_visible_tool_output_bytes",
    "package_bytes",
    "platform_overhead_tokens",
    "node_execution_count",
    "input_bytes",
    "output_bytes",
    "token_count_source",
    "filesystem_scanned_bytes",
    "model_loaded_content_bytes"
  ],
  "hard_rules": {
    "quality_baseline_required": true,
    "one_hotspot_at_a_time": true,
    "semantic_equivalence_before_performance_acceptance": true,
    "quality_regression_rejects_optimization": true,
    "accept_only_with_end_to_end_evidence": true,
    "no_score_reward_for_hard_law_compliance": true,
    "context_optimization_requires_playbook_platform_cost_separation": true,
    "local_gain_without_end_to_end_improvement_rejected": true
  },
  "diagnostics": [
    "unexplained_repeat_pass",
    "observability_coverage_gap",
    "runtime_or_token_degradation",
    "startup_context_overread",
    "eager_prompt_or_knowledge_loading",
    "platform_overhead_misattribution"
  ],
  "completion": "accepted_improvement_or_no_actionable_hotspot_or_rejected_change",
  "knowledge_refs": [
    "source/context-runtime-efficiency-policy.json",
    "source/observability-debug-policy.json",
    "source/quality-optimization-governance-policy.json"
  ],
  "optimization_history_required": true
}
